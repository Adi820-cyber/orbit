# Orbit — Environment Variables
#
# Copy this file to .env in each project root as needed.
# Never commit .env files — they are gitignored.
# Variable names only — never paste actual secrets here.
#
# See: docs/orbit/ARCHITECTURE.md §11.2

# ─── apps/web (Vercel Project 1) ───────────────────────────────────────────────
# These are PUBLIC — Vite inlines VITE_* into the browser bundle.
# Never put secrets in a VITE_ variable.

# Supabase project URL (public, safe to expose)
VITE_SUPABASE_URL=

# Supabase publishable/anon key (public, safe to expose — NOT the secret/service key)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the API backend (auto-set by Vercel Related Projects in previews)
VITE_API_BASE_URL=


# ─── services/api (Vercel Project 2) ──────────────────────────────────────────
# These are SERVER-ONLY. Never expose them in the web project or VITE_* vars.

# Supabase project URL (server copy)
SUPABASE_URL=

# Supabase publishable/anon key (server copy)
SUPABASE_PUBLISHABLE_KEY=

# Supabase JWKS endpoint for JWT verification (derived from SUPABASE_URL if omitted)
# Format: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Postgres connection string — use the Supavisor TRANSACTION MODE pooler
# Format: postgresql://orbit_app:<password>@<host>:6543/postgres
# Must connect as orbit_app (least-privilege), NOT postgres or service_role
DATABASE_URL=

# Switches the API from fail-closed stub sources to the real database-backed
# ones. Unset or false means every data route answers `unavailable` with a
# specific reason, which is the correct posture until the schema is applied and
# the entitlement matrix is seeded — see services/api/src/modules/pending.ts.
# Set to true only against an environment where migrations HAVE been applied.
ORBIT_LIVE_SOURCES=

# Exact allowed origins for CORS — EXACT origin strings only, comma-separated.
# Do NOT put patterns or wildcards here. Preview origins are matched by an
# anchored pattern built in code from VERCEL_SCOPE_SLUG below (see ADR 0007).
# Example (production): https://orbit.example.com
# Example (local dev):  http://localhost:5173
ALLOWED_ORIGINS=

# Vercel scope/team slug used to build the anchored preview-origin pattern.
# Only the slug is configurable; the pattern itself lives in reviewed source so
# a bad value fails closed (previews stop working) rather than open. See ADR 0007.
VERCEL_SCOPE_SLUG=

# ─── Ask model provider (optional — only if Aditya approves) ──────────────────
# MODEL_PROVIDER_API_KEY=
# MODEL_PROVIDER_MODEL=
# MODEL_PROVIDER_BASE_URL=

# ─── Seed/reset tooling (CI/developer machine only, never in deployed API) ────
# SEED_DATABASE_URL=

# ─── Test-only database (CI/developer machine only) ───────────────────────────
# Disposable database used by the API's RLS leak tests and pgTAP allow/deny
# suites. TEST ONLY — must never point at the production or shared dev dataset,
# and must never be set in a deployed API environment.
# Tests that need it should skip (not fail, not silently pass) when it is unset.
# Format: postgresql://<test-role>:<password>@<host>:6543/postgres
# ORBIT_TEST_DATABASE_URL=
