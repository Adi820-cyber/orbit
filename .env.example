# Orbit — Environment Variables
#
# Copy this file to .env in each project root as needed.
# Never commit .env files — they are gitignored.
# Variable names only — never paste actual secrets here.
#
# See: docs/orbit/ARCHITECTURE.md §11.2

# ─── apps/web (Vercel Project 1) ───────────────────────────────────────────────
# These are PUBLIC — Vite inlines VITE_* into the browser bundle.
# Never put secrets in a VITE_ variable.

# Supabase project URL (public, safe to expose)
VITE_SUPABASE_URL=

# Supabase publishable/anon key (public, safe to expose — NOT the secret/service key)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the API backend (auto-set by Vercel Related Projects in previews)
VITE_API_BASE_URL=


# ─── services/api (Vercel Project 2) ──────────────────────────────────────────
# These are SERVER-ONLY. Never expose them in the web project or VITE_* vars.

# Supabase project URL (server copy)
SUPABASE_URL=

# Supabase publishable/anon key (server copy)
SUPABASE_PUBLISHABLE_KEY=

# Supabase JWKS endpoint for JWT verification (derived from SUPABASE_URL if omitted)
# Format: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Postgres connection string — use the Supavisor TRANSACTION MODE pooler
# Format: postgresql://orbit_app:<password>@<host>:6543/postgres
# Must connect as orbit_app (least-privilege), NOT postgres or service_role
DATABASE_URL=

# Exact allowed origins for CORS (comma-separated production + preview origins)
ALLOWED_ORIGINS=

# ─── Ask model provider (optional — only if Aditya approves) ──────────────────
# MODEL_PROVIDER_API_KEY=
# MODEL_PROVIDER_MODEL=
# MODEL_PROVIDER_BASE_URL=

# ─── Seed/reset tooling (CI/developer machine only, never in deployed API) ────
# SEED_DATABASE_URL=
