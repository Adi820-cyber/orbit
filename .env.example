# Orbit — Environment Variables
#
# Copy this file to .env in each project root as needed.
# Never commit .env files — they are gitignored.
# Variable names only — never paste actual secrets here.
#
# See: docs/orbit/ARCHITECTURE.md §11.2

# Hosting layout (leadership and hospital operations together or separately):
# docs/orbit/DEPLOYMENT.md

# ─── apps/web (Vercel Project 1) ───────────────────────────────────────────────
# These are PUBLIC — Vite inlines VITE_* into the browser bundle.
# Never put secrets in a VITE_ variable.

# Supabase project URL (public, safe to expose)
VITE_SUPABASE_URL=

# Supabase publishable/anon key (public, safe to expose — NOT the secret/service key)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the API backend (auto-set by Vercel Related Projects in previews)
VITE_API_BASE_URL=

# Which half of Orbit this web build is, fixed at BUILD time: leader | erp | all.
# Unset = all (leadership workspace and hospital operations in one app). Use
# erp for a separate hospital-operations project. This chooses what is shown;
# the API decides what each account may read (src/lib/surface.ts).
VITE_APP_SURFACE=


# ─── services/api (Vercel Project 2) ──────────────────────────────────────────
# These are SERVER-ONLY. Never expose them in the web project or VITE_* vars.

# Supabase project URL (server copy)
SUPABASE_URL=

# Supabase publishable/anon key (server copy)
SUPABASE_PUBLISHABLE_KEY=

# Supabase JWKS endpoint for JWT verification (derived from SUPABASE_URL if omitted)
# Format: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Postgres connection string — use the Supavisor TRANSACTION MODE pooler
# Format: postgresql://orbit_app:<password>@<host>:6543/postgres
# Must connect as orbit_app (least-privilege), NOT postgres or service_role
DATABASE_URL=

# Comma-separated list of API sources to switch from fail-closed stubs to the
# real ones: memberships, entitlements, scope, entities, transitions, actions, audit,
# assignees, dataset, observations, exceptions, erp. Anything not listed
# answers `unavailable` with a specific reason (services/api/src/modules/pending.ts).
# Unset means none. An unknown name, or a database source without DATABASE_URL,
# stops the API at startup. List a database source only against an environment
# where the migrations HAVE been applied and the matching seed loaded; see
# services/api/README.md "Live sources" for when each one is ready.
# Example: ORBIT_LIVE_SOURCES=memberships,entitlements,scope
ORBIT_LIVE_SOURCES=

# Which half of Orbit this API deployment serves: leader | erp | all.
# Unset = all. leader: no /api/erp/*, operator accounts refused. erp: no leader
# routes, leadership accounts refused (services/api/src/surface.ts).
ORBIT_SURFACE=

# Exact allowed origins for CORS — EXACT origin strings only, comma-separated.
# Do NOT put patterns or wildcards here. Preview origins are matched by an
# anchored pattern built in code from VERCEL_SCOPE_SLUG below (see ADR 0007).
# Example (production): https://orbit.example.com
# Example (local dev):  http://localhost:5173
ALLOWED_ORIGINS=

# Vercel scope/team slug used to build the anchored preview-origin pattern.
# Only the slug is configurable; the pattern itself lives in reviewed source so
# a bad value fails closed (previews stop working) rather than open. See ADR 0007.
VERCEL_SCOPE_SLUG=

# ─── Ask narration providers (optional; ADR 0014) ─────────────────────────────
# SERVER ONLY. Never expose either key as a VITE_* variable — Vite inlines
# VITE_* into the browser bundle, so a model key in one is a published key.
#
# Both are optional and Ask works without them: with no key configured, answers
# stay fully deterministic, which is the current shipped behaviour. A missing key
# degrades, it does not break.
#
# What the model is allowed to do is narrow on purpose (ADR 0014 §1): it rewrites
# the prose of an answer the deterministic pipeline already built and authorized.
# It never retrieves, computes, selects records, or cites policy, and a narration
# containing a figure the source did not is discarded rather than published.
#
# Primary. Groq, OpenAI-compatible. openai/gpt-oss-20b is the default because it
# supports Structured Outputs with strict:true (constrained decoding).
# NOTE: llama-3.3-70b-versatile and llama-3.1-8b-instant are Enterprise /
# Contact Sales on Groq's models page — they will fail on a standard key.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
#
# Fallback. OpenRouter. BOTH must be set or it is treated as not configured:
# there is no default model on purpose, because OpenRouter's structured-output
# support is per *endpoint*, not per model, so the right choice depends on which
# endpoint is serving the model when you configure it. Check the
# structured_outputs parameter on the model's page before picking one.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# ─── Seed/reset tooling (CI/developer machine only, never in deployed API) ────
# SEED_DATABASE_URL=

# ─── Test-only database (CI/developer machine only) ───────────────────────────
# Disposable database used by the API's RLS leak tests and pgTAP allow/deny
# suites. TEST ONLY — must never point at the production or shared dev dataset,
# and must never be set in a deployed API environment.
# Tests that need it should skip (not fail, not silently pass) when it is unset.
# Format: postgresql://<test-role>:<password>@<host>:6543/postgres
# ORBIT_TEST_DATABASE_URL=
