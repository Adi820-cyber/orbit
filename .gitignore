supabase/.pgtap-cache/

# Sensitive source material (workbook, pitch exports) — never commit.
# See docs/source-material/README.md. Keep outside Git or in an explicitly
# approved ignored path such as this one.
Africare_Group_KPI_Framework.xlsx
*.xlsx
*.pptx
*.pdf

# Logs and local tooling
*.log
*.local
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OS/editor temporary files
*.swp
*.swo
*~

# Scratch tool output at the repo root. Agents and humans both write these while
# capturing command output; relying on remembering to delete each one is not a
# control. Named files that belong in the repo are added explicitly.
/*.txt
!/LICENSE.txt

# Environment-specific seeds and demo credentials (never committed)
supabase/seed/local/

# Vercel CLI link state (per machine)
.vercel/

.vercel
.env*
