# Orbit live hospital simulator: settings (names only; never commit real values).
# Copy to .env for a local run (`npm run start:local --workspace=@orbit/simulator`).
# On Render or Railway set these in the host's environment/secret settings instead.
# See services/simulator/README.md.

# ─── Required ──────────────────────────────────────────────────────────────────
# The ERP API to act on (https, except localhost).
ERP_API_URL=
# The Supabase project the accounts live in. Public values, same as the web app.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# The admin account. Use a strong password on any hosted run.
SIM_ADMIN_EMAIL=
SIM_ADMIN_PASSWORD=

# ─── Optional accounts ─────────────────────────────────────────────────────────
# A desk account per hospital: SIM_DESK_<HOSPITAL>_EMAIL and _PASSWORD, where
# <HOSPITAL> is the first word of its name in capitals (AVENHURST). A hospital
# without one is served by the admin account.
# SIM_DESK_AVENHURST_EMAIL=
# SIM_DESK_AVENHURST_PASSWORD=

# ─── Behaviour ─────────────────────────────────────────────────────────────────
# Comma-separated hospital keys to act on; empty = every hospital the admin can see.
# SIM_FACILITIES=avenhurst
# Seconds between ticks (5-600). 60 is the default; lower costs more API requests.
# SIM_TICK_SECONDS=60
# Same seed = same plan for the same people and days. Change it for a different "hospital".
# SIM_SEED=orbit-sim
# Visits per staff member per day, and the chance a rostered person is absent,
# late, forgets to punch out, or leaves early.
# SIM_VISITS_PER_STAFF_PER_DAY=0.6
# SIM_ABSENT_RATE=0.03
# SIM_LATE_RATE=0.06
# SIM_MISSING_OUT_RATE=0.03
# SIM_EARLY_EXIT_RATE=0.02
# SIM_MAX_OPEN_INPATIENTS=25
# SIM_ROSTER_DAYS_AHEAD=14
# Hire staff and build a service catalogue when a hospital has none. Default true.
# SIM_BOOTSTRAP=true

# ─── Safety rails ──────────────────────────────────────────────────────────────
# Reads and plans, writes nothing.
# SIM_PAUSED=false
# Most writes in one tick.
# SIM_MAX_WRITES_PER_TICK=60
# A punch up to this late is recorded by the desk at the real time; later ones
# are back-dated by the admin. Planned events older than the hours below are
# never back-filled.
# SIM_CATCHUP_SECONDS=300
# SIM_CATCHUP_MAX_HOURS=24

# ─── Day director (optional; a language model picks each hour's mood) ──────────
# Keys are tried in order: all Groq keys, then all OpenRouter keys. With none
# set, every day is an ordinary day. SERVER ONLY.
# SIM_DIRECTOR_MINUTES=60
# SIM_GROQ_KEYS=key1,key2
# SIM_GROQ_MODEL=openai/gpt-oss-20b
# SIM_OPENROUTER_KEYS=key1,key2
# SIM_OPENROUTER_MODEL=

# Set by Render/Railway when they probe a health endpoint; local runs can omit it.
# PORT=
