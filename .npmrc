; Enforce the Node floor from package.json "engines" instead of warning about it.
;
; ADR 0006 raised the floor to >=22.18 because that is where native TypeScript
; type stripping ships, and the API runs directly as .ts (`node src/app.ts`).
; On an older Node that fails with:
;
;   TypeError [ERR_UNKNOWN_FILE_EXTENSION]: Unknown file extension ".ts"
;
; which names the wrong problem. Hit on Node 22.15.0 twice during integration.
;
; Scope of this setting, measured rather than assumed: engine-strict makes
; `npm install` / `npm ci` REFUSE with a message that names the versions —
;
;   npm error notsup Required: {"node":">=22.18 <23"}
;   npm error notsup Actual:   {"npm":"10.9.2","node":"v22.15.0"}
;
; It does NOT gate `npm run`. Someone who installs on a new Node and then
; switches their shell to an older one still gets the confusing extension error
; at `npm run dev`. That gap is known and not closed here; CI runs `npm ci`, so
; the gate that matters for the build is covered.
engine-strict=true

; Reproducible installs by default; CI already uses `npm ci`.
save-exact=true
